{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:base",
    ":disableDependencyDashboard",
  ],
  timezone: "Asia/Tokyo",
  enabledManagers: ["github-actions"],
  packageRules: [
    {
      description: "GitHub Actions configuration",
      matchManagers: ["github-actions"],
      pinDigests: true,
      automerge: false,
      labels: ["renovate"],
      schedule: [
        "at 21:40 on Tuesday",
      ],
    },
  ],
}
